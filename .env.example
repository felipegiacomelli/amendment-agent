# Copy to .env (never committed) and fill in.
ANTHROPIC_API_KEY=
# SEC fair-access rules require "Name email" in the User-Agent.
SEC_USER_AGENT=Your Name you@example.com
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=25
AGENT_MAX_COST_USD=1.00
# Anthropic client: per-request timeout (seconds) and SDK retries.
AGENT_REQUEST_TIMEOUT_S=120
AGENT_MAX_RETRIES=2
